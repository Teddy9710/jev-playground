{
  "providers": [
    {
      "id": "typesafe",
      "name": "TypeSafe Jev（官方 API）",
      "kind": "typesafe",
      "model_default": "jev-latest"
    },
    {
      "id": "openai",
      "name": "OpenAI Decisions（gpt-6-luna）",
      "kind": "openai",
      "url": "https://api.openai.com/v1/decisions",
      "model_default": "gpt-6-luna",
      "key_env": "OPENAI_API_KEY"
    },
    {
      "id": "openrouter",
      "name": "OpenRouter Decisions（microsoft-decision-1 / jev）",
      "kind": "compatible",
      "url": "https://openrouter.ai/api/alpha/decisions",
      "model_default": "microsoft/microsoft-decision-1",
      "key_env": "OPENROUTER_API_KEY"
    },
    {
      "id": "intern",
      "name": "Intern-Decision（本机自部署）",
      "kind": "compatible",
      "url": "http://127.0.0.1:7860/v1/jev",
      "model_default": "intern-decision-2b",
      "key_env": ""
    },
    {
      "id": "azure-foundry",
      "name": "Azure Foundry 直连（Microsoft-Decision-1，需自建 deployment）",
      "kind": "compatible",
      "auth": "api-key",
      "url": "https://<你的资源端点>/providers/microsoft/v1/systemone",
      "model_default": "<deployment名>",
      "key_env": "AZURE_API_KEY"
    },
    {
      "id": "cloudflare",
      "name": "Cloudflare Clef 直连（clef，$0.24/MTok）",
      "kind": "compatible",
      "url": "https://api.cloudflare.com/client/v4/accounts/<你的AccountID>/ai/run/@cf/cloudflare/clef",
      "model_default": "clef",
      "key_env": "CLOUDFLARE_AUTH_TOKEN",
      "unwrap": "result",
      "price_in_mtok": 0.24
    }
  ]
}
