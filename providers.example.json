{
  "providers": [
    {
      "id": "typesafe",
      "name": "TypeSafe Jev（官方 API）",
      "kind": "typesafe",
      "model_default": "jev-latest"
    },
    {
      "id": "openai",
      "name": "OpenAI Decisions（gpt-6-luna）",
      "kind": "openai",
      "url": "https://api.openai.com/v1/decisions",
      "model_default": "gpt-6-luna",
      "key_env": "OPENAI_API_KEY"
    },
    {
      "id": "intern",
      "name": "Intern-Decision（本机自部署）",
      "kind": "compatible",
      "url": "http://127.0.0.1:7860/v1/jev",
      "model_default": "intern-decision-2b",
      "key_env": ""
    }
  ]
}
